# ===== 基础 =====
APP_NAME=education
ENV=local
DEBUG=true
LOG_LEVEL=INFO

# ===== 大模型（立项方案 3.4：Qwen3 私有化部署，OpenAI 兼容；留空则降级 Mock）=====
# LLM_PROVIDER=openai / qwen3（vLLM/SGLang 私有化，填本地端点与模型名）
LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Qwen3 思考模式（直播场景建议 false 以降延迟）
LLM_ENABLE_THINKING=false

# 多模态视觉大模型（题目图片理解 / 圈画定位）
VLM_MODEL=gpt-4o

# ===== 实时语音 Agent（立项方案 3.3：ASR=FunASR，TTS=CosyVoice2/GPT-SoVITS）=====
# ASR_PROVIDER=openai / funasr / mock
ASR_PROVIDER=openai
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=whisper-1
# FunASR（中文课堂优，流式+VAD）
FUNASR_MODEL=paraformer-zh
FUNASR_HOTWORDS=
# TTS_PROVIDER=openai / edge / cosyvoice / gptsovits / mock
TTS_PROVIDER=openai
TTS_API_BASE=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
# 克隆音色参考干声（CosyVoice2 / GPT-SoVITS zero-shot 克隆）
TTS_REF_AUDIO=
TTS_REF_TEXT=
COSYVOICE_API_BASE=
GPTSOVITS_API_BASE=

# ===== OCR =====
OCR_PROVIDER=paddle
OCR_CLOUD_KEY=

# ===== 实时通信 =====
HOST=0.0.0.0
PORT=8000
WEBSOCKET_PATH=/ws

# ===== 音视频 =====
RTC_PROVIDER=webrtc
RTC_APP_ID=
RTC_APP_SECRET=

# ===== 白板 / 数据库 =====
BOARD_SNAPSHOT_DIR=data/raw/board_snapshots
DATABASE_URL=sqlite:///education.db

# ===== 记忆 / RAG =====
MEMORY_BACKEND=sqlite
RAG_TOP_K=4

# ===== 编排引擎（builtin：自研 TaskGraph；langgraph：LangGraph StateGraph）=====
ORCHESTRATOR=builtin

# ===== 数字人（真实 TTS 音频 + 口型同步）=====
DIGITAL_HUMAN_ENABLE=true
DIGITAL_HUMAN_VISEME_ENABLE=true

# ===== 数字人渲染引擎（立项方案 3.1/3.2）=====
# L3 实时口型：mock（前端照片木偶，无需 GPU，默认）/ placeholder（静态图+音频占位视频）/ http / musetalk（MuseTalk1.5）/ latentsync
AVATAR_BACKEND=mock
AVATAR_API_BASE=
AVATAR_API_KEY=
AVATAR_TIMEOUT_SECONDS=60
# 老师肖像图（L1 离线渲染 HunyuanVideo/Hallo2 驱动用）
AVATAR_SOURCE_IMAGE=
# L3 MuseTalk 渲染帧率：必须与底片视频实际 fps 一致（data/raw/老师15s.mp4 默认 25）
# 传 30 而底片是 25 会导致画面加速/口型不同步
AVATAR_FPS=25
# L3 MuseTalk 人脸框上下平移：正值向下（多包下巴/脖子），负值向上（多包额头）
# 官方推荐区间 [-10, 10]；下巴被切用 -5，脖子入镜太多用 +3~+5
AVATAR_BBOX_SHIFT=-4
# L1 离线高质量渲染：mock / hunyuan（HunyuanVideo-Avatar）/ hallo2（Hallo2）
L1_AVATAR_BACKEND=mock
L1_AVATAR_API_BASE=
L1_AVATAR_API_KEY=
L1_AVATAR_TIMEOUT_SECONDS=600
# 引擎返回的视频是否自带音轨（真实引擎为 true）；false 时会额外下发 TTS 音频
AVATAR_VIDEO_HAS_AUDIO=true
# 无 TTS 音频时是否仍调用渲染服务（仅用于示例视频空跑链路，生产保持 false）
AVATAR_ALLOW_SILENT_AUDIO=false

# ===== AI 教师驱动视频源（换人只改这里）=====
# 主底片：放入 data/ai_teacher/talk.mp4 即可；缺失或校验不通过会自动回退
AI_TEACHER_VIDEO_PATH=data/ai_teacher/talk.mp4
# 回退底片：默认指向归档旧素材，保证新素材未就绪时链路仍可跑通
AI_TEACHER_FALLBACK_PATH=data/legacy/talk.mp4
# 动作基元库目录（talk/nod/shake/shrug/point.mp4，可选 idle.mp4）；引擎按此目录加载
AI_TEACHER_CLIP_DIR=data/ai_teacher
# 人脸预处理本地缓存根目录（按 video_hash 分子目录，换源自动失效）
AVATAR_CACHE_DIR=data/cache
# 校验阈值：分辨率最短边（像素，默认 512）；最低帧率（MuseTalk 标准 24fps）
AI_TEACHER_MIN_SIDE=512
AI_TEACHER_MIN_FPS=24

# ===== 互动式追问（讲完题主动提问并等学生作答）=====
INTERACTION_ENABLE=true
INTERACTION_MAX_FOLLOWUPS=1
INTERACTION_MAX_RETRIES=2

# ===== 1v1 学科辅导课（学科选择页 -> 打招呼 -> 讲解+出题 -> 总结答疑）=====
COURSE_ENABLE=true
COURSE_DURATION_MINUTES=40
COURSE_QUIZ_ENABLE=true

# ===== 空闲主动问候（学生静默 N 秒后 AI 主动打招呼，并“对应上 AI 刚才问的问题”）=====
IDLE_NUDGE_ENABLE=true
IDLE_NUDGE_SECONDS=30
IDLE_NUDGE_MAX=3

# ===== 防逆向 / 防盗用 =====
ANTI_REV_SECRET=dev-secret-change-me
RATE_LIMIT_PER_MIN=240
