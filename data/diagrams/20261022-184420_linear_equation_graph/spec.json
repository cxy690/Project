{
  "type": "curve",
  "title": "二元一次方程 2x + y = 4 的图象",
  "subtitle": "一条直线：取两点连线即可",
  "theme": "light",
  "canvas": "square",
  "formulas": [
    "2x + y = 4",
    "x=0 → y=4 → A(0,4)",
    "y=0 → x=2 → B(2,0)",
    "检验：x=1 → y=2"
  ],
  "steps": [
    {
      "title": "第一步：令 x=0，求与 y 轴交点",
      "points": [
        [
          0,
          4
        ]
      ],
      "note": "2×0 + y = 4，得 y = 4，点 A(0,4)"
    },
    {
      "title": "第二步：令 y=0，求与 x 轴交点",
      "points": [
        [
          0,
          4
        ],
        [
          2,
          0
        ]
      ],
      "note": "2x + 0 = 4，得 x = 2，点 B(2,0)"
    },
    {
      "title": "第三步：过两点画直线",
      "points": [
        [
          0,
          4
        ],
        [
          2,
          0
        ]
      ],
      "line": true,
      "note": "两点确定一条直线，这条直线就是方程的图象"
    },
    {
      "title": "第四步：取第三点检验",
      "points": [
        [
          0,
          4
        ],
        [
          2,
          0
        ],
        [
          1,
          2
        ]
      ],
      "line": true,
      "note": "x=1 时 y=2，点 (1,2) 落在直线上，画得对"
    }
  ]
}